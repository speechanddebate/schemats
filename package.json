{
  "name": "tournaments",
  "version": "1.0.0",
  "description": "Single Next.js app with BetterAuth and ShadCN for speech and debate tournaments",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run next-dev\" \"npm run backend-dev\"",
    "next-dev": "next dev",
    "next-build": "next build",
    "next-start": "next start",
    "backend-dev": "node tournaments-backend/app.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest --watch",
    "test:run": "vitest --run"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-slot": "^1.2.2",
    "better-auth": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.3",
    "lucide-react": "^0.525.0",
    "next": "^15.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.1.7",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.4",
    "@typescript-eslint/eslint-plugin": "^9.2.0",
    "@typescript-eslint/parser": "^9.2.0",
    "@typescript-eslint/plugin": "^9.2.0",
    "@typescript-eslint/stylistic-type-checked": "^9.2.0",
    "@typescript-eslint/type-utils": "^9.2.0",
    "@typescript-eslint/typescript-estree": "^9.2.0",
    "autoprefixer": "^9.7.18",
    "eslint": "^9.3.0",
    "eslint-config-next": "^15.4.3",
    "eslint-plugin-import": "^2.31.0",
    "postcss": "^9.7.7",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8"
  },
  "engines": {
    "node": ">=20.x"
  }
}